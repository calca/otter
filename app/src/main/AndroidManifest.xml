<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: specifica il tipo del foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: necessario per mostrare notifiche -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pausa di gruppo: solo per scansionare il QR di invito
         (GroupPauseJoinScreen) — l'inserimento manuale del codice resta
         disponibile senza questo permesso/hardware, da cui required="false". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Pausa di gruppo, lobby dal vivo (Fase 2) — solo per la modalità
         Bluetooth di GroupPauseHostScreen/GroupPauseJoinScreen; QR/codice
         manuale (Fase 1) resta disponibile senza questi permessi/hardware,
         da cui required="false" sulle uses-feature. Vedi
         specs/group-pause/design.md e PermissionChecks.kt. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- neverForLocation: il discovery non viene mai usato per dedurre la
         posizione fisica, solo per trovare il dispositivo dell'altra
         persona — evita di dover chiedere anche ACCESS_FINE_LOCATION. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!-- Android 11+ (API 30+): senza questo blocco, queryIntentActivities()
         in AllowedAppsActivity.loadApps() vedrebbe solo un sottoinsieme delle
         app installate per via delle restrizioni di package visibility. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Stesso motivo, ma per LauncherManager/MainActivity: senza questo,
             il vero launcher del telefono (es. com.google.android.apps.
             nexuslauncher, che a differenza di com.android.settings NON è
             sempre visibile di default) può risultare invisibile a
             queryIntentActivities/resolveActivity per CATEGORY_HOME,
             facendo fallire sia il rilevamento del "launcher originale" sia
             il forward di sicurezza in MainActivity.findAnyOtherHomePackage()
             — bug reale osservato e corretto. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CalmOtter"
        android:supportsRtl="true">

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.CalmOtter.WithActionBar">
        </activity>

        <!--
            Due intent-filter sulla stessa Activity: icona del launcher
            (comportamento invariato) e app Home (quando impostata da
            Settings, vedi SettingsActivity.promptSetAsHome()) — prima erano
            due classi separate (questa e la ormai rimossa HomeActivity),
            unificate su richiesta esplicita per ridurre la duplicazione, a
            parità di comportamento. launchMode="singleTask": una pressione
            del tasto Home mentre un'istanza è già viva le riconsegna
            l'Intent tramite onNewIntent() invece di impilarne una nuova —
            vedi MainActivity.kt.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GroupPauseHostActivity"
            android:exported="false"
            android:theme="@style/Theme.CalmOtter" />

        <activity
            android:name=".GroupPauseJoinActivity"
            android:exported="false"
            android:theme="@style/Theme.CalmOtter" />

        <activity
            android:name=".GroupPauseChooserActivity"
            android:exported="false"
            android:theme="@style/Theme.CalmOtter" />

        <activity
            android:name=".BlockOverlayActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CalmOtter.Block" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:theme="@style/Theme.CalmOtter.WithActionBar" />

        <activity
            android:name=".ChangePasswordActivity"
            android:exported="false"
            android:label="@string/change_password_title"
            android:theme="@style/Theme.CalmOtter.WithActionBar" />

        <activity
            android:name=".AllowedAppsActivity"
            android:exported="false"
            android:label="@string/allowed_apps_title"
            android:theme="@style/Theme.CalmOtter.WithActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.CalmOtter.WithActionBar" />

        <!--
            RECEIVE_BOOT_COMPLETED: al riavvio del telefono, se una sessione
            era in corso, ripristina il blocco e il DND.
            directBootAware=false (default): il receiver parte solo dopo che
            l'utente ha sbloccato il telefono con PIN/impronta al boot — non
            ci servono i dati cifrati prima di quel punto, e tenerlo false
            evita complessità inutile.
        -->
        <receiver
            android:name=".PauseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_idle">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pause_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Alcuni dispositivi Huawei/MIUI usano questo invece di BOOT_COMPLETED -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantiene attivo il blocco sessione di pausa" />
        </service>

        <receiver
            android:name=".SessionExpiryReceiver"
            android:exported="false" />

        <!-- Pausa di gruppo, lobby dal vivo (Fase 2) — lato "carta" NFC
             opzionale, vedi GroupPauseHceService.kt e
             specs/group-pause/design.md. exported="true" è richiesto qui:
             è il sistema stesso (non un'altra app) a doversi collegare a
             questo servizio quando instrada un tap NFC verso il nostro
             AID — protetto da android:permission,
             che solo il sistema possiede, non un'eccezione accidentale
             alla convenzione exported="false" del resto di questo file. -->
        <service
            android:name=".nfc.GroupPauseHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <service
            android:name=".AppBlockerAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice.config"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Espone il CSV di export cronologia (cache dir) via content:// URI,
             necessario per condividerlo tramite ACTION_SEND senza incorrere
             in FileUriExposedException sulle versioni recenti di Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
