<?xml version="1.0" encoding="utf-8"?>
<!--
    Azione "svuota cronologia", promossa da voce dell'overflow a icona
    nell'ActionBar (vedi HistoryActivity.onCreateOptionsMenu).

    Resta dietro a ClearHistoryConfirmDialog: da icona sempre visibile è più
    facile da toccare per sbaglio di quanto non fosse dentro l'overflow, e
    l'azione non è annullabile, quindi la conferma serve ancora di più di
    prima — non è stata tolta "perché ora si vede".

    Tint come ic_history_share.xml: vedi lì il perché di colorControlNormal.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z" />
</vector>
