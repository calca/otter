<?xml version="1.0" encoding="utf-8"?>
<!--
    "Zen Otter": la mascotte del redesign (design system "Calm Otter
    Sanctuary") — muso di fronte, occhi chiusi in due archi, guance rosate.
    Geometria presa dall'SVG originale, non ridisegnata a mano; la versione
    precedente ("Still Otter") resta in
    ic_launcher_foreground_still_otter.xml.

    Viewport 120 come l'SVG di partenza, mentre width/height restano 108dp:
    il contenuto occupa 66 unità su 120, cioè meno del cerchio di sicurezza
    dell'adaptive icon (66 su 108 → 73 su 120), quindi sopravvive a
    qualunque maschera applicata dal launcher.

    Colori fissi e non della palette: è l'icona nel launcher, dove il tema
    scelto dentro l'app non ha modo di arrivare.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!-- orecchie (pelo) -->
    <path
        android:fillColor="#8FA693"
        android:pathData="M27,38 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0
                           M75,38 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
    <!-- padiglioni -->
    <path
        android:fillColor="#EEF3ED"
        android:pathData="M31,38 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0
                           M79,38 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <!-- testa -->
    <path
        android:fillColor="#8FA693"
        android:pathData="M34,56 C34,40 45,32 60,32 C75,32 86,40 86,56
                           C89,64 88,74 82,81 C75,88 68,89 60,89
                           C52,89 45,88 38,81 C32,74 31,64 34,56 Z" />
    <!-- muso -->
    <path
        android:fillColor="#EEF3ED"
        android:pathData="M44,67 a16,12 0 1,0 32,0 a16,12 0 1,0 -32,0" />
    <!-- guance -->
    <path
        android:fillColor="#73D7A99C"
        android:pathData="M36.5,63 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0
                           M74.5,63 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <!-- occhi chiusi -->
    <path
        android:strokeColor="#16241D"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M44,54 Q49,50 54,54 M66,54 Q71,50 76,54" />
    <!-- naso, filtro e sorriso -->
    <path
        android:fillColor="#16241D"
        android:pathData="M56.5,63 a3.5,2.6 0 1,0 7,0 a3.5,2.6 0 1,0 -7,0" />
    <path
        android:strokeColor="#16241D"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M60,65.5 L60,68" />
    <path
        android:strokeColor="#16241D"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M56,68.5 Q60,71 64,68.5" />
</vector>
