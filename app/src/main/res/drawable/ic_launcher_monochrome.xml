<?xml version="1.0" encoding="utf-8"?>
<!--
    Versione per l'icona "themed"/monocromatica (Android 13+, Material You):
    il sistema tinge tutto con un solo colore, leggendo solo il canale alfa
    del vector — un'icona composta solo dalla sagoma testa+orecchie
    (una versione precedente di questo file, senza occhi/naso) risultava una
    macchia tonda indistinguibile accanto alle icone di altre app, che
    restano riconoscibili anche ridotte a un solo colore.

    Occhi e naso sono "ritagliati" nella sagoma disegnandoli nello stesso
    path ma con **verso di percorrenza opposto** (flag di sweep 1 invece di
    0), sfruttando la regola "nonzero": le sotto-forme concordi si sommano,
    quelle discordi si sottraggono.

    NON usare fillType="evenOdd" qui, anche se a prima vista sembra la via
    più semplice per fare i buchi (lo è, in generale: evenOdd non dipende
    dal verso, quindi non costringe a invertire nulla a mano). Su *questa*
    sagoma rompe le orecchie: i due cerchi delle orecchie si sovrappongono
    a quello della testa, e con evenOdd la zona comune conta come "dentro
    due sotto-forme" — numero pari — quindi diventa trasparente. Il
    risultato è un otter con due mezzelune bianche al posto delle orecchie.
    È successo davvero, segnalato con screenshot dal launcher, dopo che una
    modifica precedente era passata a evenOdd verificando solo che occhi e
    naso venissero bucati, senza guardare le orecchie.

    Verificato renderizzando i pathData fuori da Android, tutte e tre le
    varianti a confronto (evenOdd; nonzero a versi concordi; nonzero con i
    buchi invertiti), e controllando *l'intera* sagoma, orecchie comprese.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M29,58 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0
                           M30,42 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0
                           M58,42 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0
                           M40,62 a6,2.2 0 1,1 12,0 a6,2.2 0 1,1 -12,0
                           M56,62 a6,2.2 0 1,1 12,0 a6,2.2 0 1,1 -12,0
                           M51.5,72 a2.5,2.5 0 1,1 5,0 a2.5,2.5 0 1,1 -5,0" />
</vector>
