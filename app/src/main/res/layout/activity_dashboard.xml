<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".DashboardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Calm Otter"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Timer Dial Selector -->
            <FrameLayout
                android:id="@+id/timerDialContainer"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_timer_dial">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/timerProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:indicatorSize="240dp"
                    app:trackThickness="8dp"
                    app:trackColor="@color/surface_container"
                    app:indicatorColor="@color/primary"
                    android:progress="20"
                    app:trackCornerRadius="4dp" />

                <!-- Thumb / Cursore trascinabile -->
                <View
                    android:id="@+id/timerThumb"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_timer_thumb"
                    android:translationY="-120dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timerValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25"
                        android:textAppearance="?attr/textAppearanceDisplayLarge"
                        android:textColor="@color/primary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="minuti"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trascina il cursore per impostare la durata della tua sessione di focus."
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="40dp" />

            <!-- Main Actions -->
            <Button
                android:id="@+id/startSessionButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Inizia Sessione"
                app:icon="@drawable/ic_play"
                app:cornerRadius="28dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/advancedSettingsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Impostazioni Avanzate"
                app:cornerRadius="28dp"
                android:layout_marginBottom="32dp" />

            <!-- Partner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/secondary_container"
                android:layout_marginBottom="100dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/partnerAvatarFrame">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Partner di Responsabilità"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/on_secondary_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Marco è attualmente online."
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/on_secondary_container"
                                android:alpha="0.8" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/partnerAvatarFrame"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/avatar_marco"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                android:strokeColor="@color/primary_container"
                                app:strokeWidth="2dp" />

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_online_indicator" />
                        </FrameLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Scrivi"
                            app:chipIcon="@drawable/ic_chat"
                            app:chipBackgroundColor="@color/surface_container_low"
                            app:chipStrokeWidth="0dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall" />

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sincronizza"
                            app:chipIcon="@drawable/ic_sync"
                            app:chipBackgroundColor="@color/surface_container_low"
                            app:chipStrokeWidth="0dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        app:menu="@menu/dashboard_menu"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
