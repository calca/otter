<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp">

        <!-- SAGE -->
        <LinearLayout
            android:id="@+id/themeSage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <View
                android:id="@+id/dotSage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/theme_dot_sage" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_sage"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- LAVENDER -->
        <LinearLayout
            android:id="@+id/themeLavender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <View
                android:id="@+id/dotLavender"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/theme_dot_lavender" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_lavender"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- TERRACOTTA -->
        <LinearLayout
            android:id="@+id/themeTerracotta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <View
                android:id="@+id/dotTerracotta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/theme_dot_terracotta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_terracotta"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
