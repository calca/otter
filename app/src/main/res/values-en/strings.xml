    <!-- Onboarding -->
    <string name="onb1_title">Welcome to Calm Otter</string>
    <string name="onb1_body">Calm Otter helps you take real breaks from your phone — no distractions, no notifications. Just you and the present moment.</string>
    <string name="onb2_title">How it works</string>
    <string name="onb2_body">When you want a break, choose how long and start the session.\n\nAll apps are blocked, except the phone for calls.\n\nThe session ends automatically when the time is up, or earlier — but only if a trusted person enters the password.\n\nIt\'s a pact between you and someone who cares about you.</string>
    <string name="onb3_title">Two permissions needed</string>
    <string name="onb3_body">To work, Calm Otter needs:\n\n🔍 Accessibility — to detect which app is open and show the lock screen.\n\n🔔 Do Not Disturb — to silence notifications during the pause, allowing only calls.\n\nNo data is shared or transmitted.</string>
    <string name="onb3_btn_accessibility">Grant Accessibility access</string>
    <string name="onb3_btn_dnd">Grant Do Not Disturb access</string>
    <string name="onb3_permissions_ok">✓ All permissions granted</string>
    <string name="onb3_missing_dnd">✓ Accessibility ok · Waiting for Do Not Disturb</string>
    <string name="onb3_missing_accessibility">✓ Do Not Disturb ok · Waiting for Accessibility</string>
    <string name="onb3_missing_both">Both permissions are required to continue</string>
    <string name="onb4_title">Choose the password together</string>
    <string name="onb4_body">Hand the phone to your trusted person.\n\nThey will choose the password — and keep it to themselves. Only they can end a session early.\n\nYou don\'t need to know the password: it\'s part of the pact.</string>
    <string name="onb5_title">All set 🌿</string>
    <string name="onb5_body">Calm Otter is configured.\n\nWhenever you\'re ready for a break, open the app, choose a duration and start.\n\nTake care of yourself.</string>
    <string name="onb_next">Next</string>
    <string name="onb_back">Back</string>
    <string name="onb_finish">Let\'s go</string>

    <!-- Relaxing phrases shown during pause (optional) -->
    <string-array name="pause_phrases">
        <item>Breathe. This moment is yours.</item>
        <item>Silence is a form of self-respect.</item>
        <item>You\'re not missing anything. You\'re gaining something.</item>
        <item>The mind needs emptiness to make room for ideas.</item>
        <item>Every pause is a small act of self-care.</item>
        <item>Look out the window. The world is still there.</item>
        <item>What would you do if you didn\'t have your phone right now?</item>
        <item>Boredom is the fertile ground of creativity.</item>
        <item>You are more present than you think.</item>
        <item>Less screen, more depth.</item>
        <item>The body knows what to do when the mind slows down.</item>
        <item>You\'re choosing the present over the screen.</item>
