    <!-- Overlay del popup dell'ActionBar per palette, tema scuro — vedi
         commento su actionBarPopupTheme in Theme.CalmOtter.Sage.WithActionBar
         sopra. Estende ThemeOverlay.MaterialComponents.Dark (il default
         della libreria per questo stesso attributo su un tema
         MaterialComponents) invece di ThemeOverlay.Material3.Light usato
         nel file values/themes.xml — questo file resta sullo schema
         MaterialComponents pre-redesign, vedi CalmOtterTheme.kt. -->
    <style name="ThemeOverlay.CalmOtter.Sage.PopupMenu" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorSurface">@color/sage_dark_surface</item>
        <item name="colorOnSurface">#dde5dc</item>
        <item name="popupMenuBackground">@color/sage_dark_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.DeepForest.PopupMenu" parent="ThemeOverlay.MaterialComponents.Dark">
