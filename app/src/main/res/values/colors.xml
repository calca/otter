    <!-- Material 3 Structural Colors -->
    <color name="m3_error">#ba1a1a</color>
    <color name="m3_on_error">#ffffff</color>
    <color name="m3_error_container">#ffdad6</color>
    <color name="m3_on_error_container">#93000a</color>
    <color name="m3_outline">#707973</color>
    <color name="m3_outline_variant">#bfc9c1</color>

    <!-- LE QUATTRO PALETTE
         Valori importati dai design system generati in Stitch (progetto
         3158702940609906617): "Sage Sanctuary", "Calm Otter Sanctuary"
         (= Deep Forest), "Dusk Sand Sanctuary", "Dawn Clay". Dusk Sand e
         Dawn Clay prendono il posto di Lavanda e Terracotta, anche nelle
         preferenze gia' salvate (vedi AppTheme.fromKey).

         Un'eccezione dichiarata: i sistemi "Sage" e "Calm Otter" generano
         lo stesso primary (#1b3b2b), il che renderebbe Salvia e Deep Forest
         due temi identici nell'elenco. Salvia tiene quindi il proprio verde
         (#0f5238), piu' chiaro e saturo, e adotta dal redesign solo
         superfici, neutri e contenitori. -->
    <!-- SAGE THEME -->
    <!-- DEEP FOREST — quarta palette, importata dal redesign Stitch
         ("Calm Otter Sanctuary", progetto 3158702940609906617). Valori presi
         dai token del design system, non riportati a occhio: primary =
         Deep Forest Pine, secondary = la sua variante leggibile su chiaro
         (#8fa693, la "Muted Mountain Sage" del documento, non regge il
         contrasto come colore di testo), surface = Warm Alabaster. -->
    <color name="deep_forest_primary">#1b3b2b</color>
    <color name="deep_forest_on_primary">#ffffff</color>
    <color name="deep_forest_primary_container">#2d4d3c</color>
    <color name="deep_forest_on_primary_container">#c7ebd4</color>
    <color name="deep_forest_secondary">#4e6353</color>
    <color name="deep_forest_on_secondary">#ffffff</color>
    <color name="deep_forest_secondary_container">#cee6d1</color>
    <color name="deep_forest_on_secondary_container">#526857</color>
    <color name="deep_forest_background">#f8f9f5</color>
    <color name="deep_forest_surface">#f8f9f5</color>
    <color name="deep_forest_on_surface">#1a1c1a</color>
    <!-- accent = "secondary" del design system (mascotte, controlli),
         veil = "tertiary" (anelli dello stagno, riempimenti tenui) -->
    <color name="deep_forest_accent">#8fa693</color>
    <color name="deep_forest_veil">#d5e0d5</color>
    <color name="deep_forest_surface_variant">#e2e3df</color>

    <color name="sage_primary">#0f5238</color>
