<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LE QUATTRO PALETTE — UNICA FONTE DEI COLORI.

         Ogni palette ha nove ruoli (`<palette>_<ruolo>`), definiti qui per il
         chiaro e in values-night/colors.xml per lo scuro con gli stessi
         nomi: la risorsa giusta la sceglie Android in base alla modalita'.
         Li leggono entrambi i sistemi — gli overlay in themes.xml (finestra,
         ActionBar) e CalmOtterTheme.kt (Compose, via colorResource) — quindi
         non c'e' niente da tenere allineato a mano. CalmOtterPaletteTest
         controlla che ogni palette li definisca tutti, in entrambe le
         modalita', e che il contrasto di testo e CTA regga.

         Ruoli: background/surface/surface_bright (sfondo, superfici, disco
         centrale dello stagno), on_background/on_surface (testo), primary e
         on_primary (CTA), accent (mascotte e controlli), veil (anelli dello
         stagno, riempimenti tenui). -->
    <!-- Colori strutturali condivisi dalle palette. m3_error ha il suo
         valore scuro in values-night/colors.xml. -->
    <color name="m3_error">#ba1a1a</color>
    <color name="m3_on_error">#ffffff</color>
    <color name="m3_error_container">#ffdad6</color>
    <color name="m3_on_error_container">#93000a</color>
    <color name="m3_outline">#707973</color>
    <color name="m3_outline_variant">#bfc9c1</color>

