<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Struttura dei temi: una BASE per tipo di schermata (senza o con
         ActionBar nativa) e, sopra, un OVERLAY per palette che porta solo i
         colori. ThemeManager.applyTheme() li applica in quest'ordine prima
         di super.onCreate(). I colori non stanno qui: sono riferimenti a
         values/colors.xml (e al suo gemello values-night/), che e' l'unica
         fonte e la stessa che legge Compose — vedi lì. DayNight sceglie da
         solo i valori chiari o scuri, quindi non esiste un themes.xml
         notturno. -->

    <!-- Material 3 Structural Base (No ActionBar) -->
    <style name="Theme.CalmOtter.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="materialButtonStyle">@style/Widget.CalmOtter.Button</item>
    </style>

    <!-- Material 3 Structural Base (With ActionBar) -->
    <style name="Theme.CalmOtter.Base.WithActionBar" parent="Theme.Material3.DayNight">
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="materialButtonStyle">@style/Widget.CalmOtter.Button</item>
    </style>

    <!-- Overlay di palette: solo colori. Nessun genitore, si applicano sopra
         una delle due basi. L'ActionBar nativa legge questi valori (titolo,
         icone), il resto delle schermate e' Compose. `colorOnSurface` punta
         a on_background, il testo pieno: e' quello che colora il titolo
         della ActionBar, e con on_surface (piu' smorzato in scuro) risultava
         spento rispetto a prima. Niente tema del popup
         dell'overflow: l'app non ne ha (le azioni di Cronologia sono sempre
         visibili). -->
    <style name="ThemeOverlay.CalmOtter.Sage" parent="">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="android:colorBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_background</item>
        <item name="colorOnSurfaceVariant">@color/sage_on_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.StillWater" parent="">
        <item name="colorPrimary">@color/still_water_primary</item>
        <item name="colorOnPrimary">@color/still_water_on_primary</item>
        <item name="android:windowBackground">@color/still_water_background</item>
        <item name="android:colorBackground">@color/still_water_background</item>
        <item name="colorSurface">@color/still_water_surface</item>
        <item name="colorOnSurface">@color/still_water_on_background</item>
        <item name="colorOnSurfaceVariant">@color/still_water_on_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.DuskSand" parent="">
        <item name="colorPrimary">@color/dusk_sand_primary</item>
        <item name="colorOnPrimary">@color/dusk_sand_on_primary</item>
        <item name="android:windowBackground">@color/dusk_sand_background</item>
        <item name="android:colorBackground">@color/dusk_sand_background</item>
        <item name="colorSurface">@color/dusk_sand_surface</item>
        <item name="colorOnSurface">@color/dusk_sand_on_background</item>
        <item name="colorOnSurfaceVariant">@color/dusk_sand_on_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.DawnClay" parent="">
        <item name="colorPrimary">@color/dawn_clay_primary</item>
        <item name="colorOnPrimary">@color/dawn_clay_on_primary</item>
        <item name="android:windowBackground">@color/dawn_clay_background</item>
        <item name="android:colorBackground">@color/dawn_clay_background</item>
        <item name="colorSurface">@color/dawn_clay_surface</item>
        <item name="colorOnSurface">@color/dawn_clay_on_background</item>
        <item name="colorOnSurfaceVariant">@color/dawn_clay_on_surface</item>
    </style>

    <!-- Temi di partenza dichiarati nel manifest: la finestra iniziale (prima
         che BaseActivity applichi la palette scelta) e' sempre quella
         predefinita, Sage. Stesse nove voci dell'overlay Sage, come
         riferimenti: nessun valore duplicato. -->
    <style name="Theme.CalmOtter" parent="Theme.CalmOtter.Base">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="android:colorBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_background</item>
        <item name="colorOnSurfaceVariant">@color/sage_on_surface</item>
    </style>
    <style name="Theme.CalmOtter.WithActionBar" parent="Theme.CalmOtter.Base.WithActionBar">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="android:colorBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_background</item>
        <item name="colorOnSurfaceVariant">@color/sage_on_surface</item>
    </style>

    <!-- Shared Styles -->
    <style name="Widget.CalmOtter.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.CalmOtter.Pill</item>
    </style>

    <style name="ShapeAppearance.CalmOtter.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.CalmOtter.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
