<resources>

    <!-- Material 3 Structural Base (No ActionBar) -->
    <style name="Theme.CalmOtter.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>

        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="materialButtonStyle">@style/Widget.CalmOtter.Button</item>
    </style>

    <!-- Material 3 Structural Base (With ActionBar) -->
    <style name="Theme.CalmOtter.Base.WithActionBar" parent="Theme.Material3.DayNight">
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>

        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="materialButtonStyle">@style/Widget.CalmOtter.Button</item>
    </style>

    <!-- SAGE THEME -->
    <style name="Theme.CalmOtter.Sage" parent="Theme.CalmOtter.Base">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="colorPrimaryContainer">@color/sage_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sage_on_primary_container</item>
        <item name="colorSecondary">@color/sage_secondary</item>
        <item name="colorOnSecondary">@color/sage_on_secondary</item>
        <item name="colorSecondaryContainer">@color/sage_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sage_on_secondary_container</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_surface</item>
        <item name="colorSurfaceVariant">@color/sage_surface_variant</item>
        <item name="colorOnSurfaceVariant">#404943</item>
    </style>
    <style name="Theme.CalmOtter.Sage.Block" parent="Theme.CalmOtter.Sage" />
    <style name="Theme.CalmOtter.Sage.WithActionBar" parent="Theme.CalmOtter.Base.WithActionBar">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="colorPrimaryContainer">@color/sage_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sage_on_primary_container</item>
        <item name="colorSecondary">@color/sage_secondary</item>
        <item name="colorOnSecondary">@color/sage_on_secondary</item>
        <item name="colorSecondaryContainer">@color/sage_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sage_on_secondary_container</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_surface</item>
        <item name="colorSurfaceVariant">@color/sage_surface_variant</item>
        <item name="colorOnSurfaceVariant">#404943</item>
    </style>

