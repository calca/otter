        <item name="colorOnPrimary">@color/terracotta_on_primary</item>
        <item name="colorPrimaryContainer">@color/terracotta_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/terracotta_on_primary_container</item>
        <item name="colorSecondary">@color/terracotta_secondary</item>
