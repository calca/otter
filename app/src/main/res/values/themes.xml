        <item name="colorOnSurface">@color/dawn_clay_on_surface</item>
        <item name="colorSurfaceVariant">@color/dawn_clay_surface_variant</item>
        <item name="colorOnSurfaceVariant">#53433f</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.CalmOtter.DawnClay.PopupMenu</item>
    </style>

    <!-- Overlay del popup dell'ActionBar per palette (vedi actionBarPopupTheme
         sopra) — popupMenuBackground esplicito, non solo colorSurface: il
         drawable di default (Widget.Material3.PopupMenu.Overflow) usa un
         macro M3 (@macro/m3_comp_menu_container_color) che non è detto legga
         colorSurface, quindi si sovrascrive direttamente l'attributo che il
         widget style consulta davvero, eliminando l'ambiguità. -->
    <style name="ThemeOverlay.CalmOtter.Sage.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_surface</item>
        <item name="popupMenuBackground">@color/sage_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.DeepForest.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/deep_forest_surface</item>
        <item name="colorOnSurface">@color/deep_forest_on_surface</item>
        <item name="popupMenuBackground">@color/deep_forest_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.DuskSand.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/dusk_sand_surface</item>
        <item name="colorOnSurface">@color/dusk_sand_on_surface</item>
        <item name="popupMenuBackground">@color/dusk_sand_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.DawnClay.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/dawn_clay_surface</item>
        <item name="colorOnSurface">@color/dawn_clay_on_surface</item>
        <item name="popupMenuBackground">@color/dawn_clay_surface</item>
    </style>

    <!-- Shared Styles -->
    <style name="Widget.CalmOtter.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.CalmOtter.Pill</item>
    </style>

    <style name="ShapeAppearance.CalmOtter.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.CalmOtter.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Default Aliases -->
    <style name="Theme.CalmOtter"          parent="Theme.CalmOtter.Sage" />
    <style name="Theme.CalmOtter.Block"    parent="Theme.CalmOtter.Sage.Block" />
    <style name="Theme.CalmOtter.WithActionBar" parent="Theme.CalmOtter.Sage.WithActionBar" />

</resources>
