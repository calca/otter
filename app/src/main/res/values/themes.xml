<resources>

    <!-- Material 3 Structural Base (No ActionBar) -->
    <style name="Theme.CalmOtter.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>

        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="materialButtonStyle">@style/Widget.CalmOtter.Button</item>
    </style>

    <!-- Material 3 Structural Base (With ActionBar) -->
    <style name="Theme.CalmOtter.Base.WithActionBar" parent="Theme.Material3.DayNight">
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>

        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalmOtter.Large</item>
        <item name="materialButtonStyle">@style/Widget.CalmOtter.Button</item>
    </style>

    <!-- SAGE THEME -->
    <style name="Theme.CalmOtter.Sage" parent="Theme.CalmOtter.Base">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="colorPrimaryContainer">@color/sage_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sage_on_primary_container</item>
        <item name="colorSecondary">@color/sage_secondary</item>
        <item name="colorOnSecondary">@color/sage_on_secondary</item>
        <item name="colorSecondaryContainer">@color/sage_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sage_on_secondary_container</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_surface</item>
        <item name="colorSurfaceVariant">@color/sage_surface_variant</item>
        <item name="colorOnSurfaceVariant">#404943</item>
    </style>
    <style name="Theme.CalmOtter.Sage.Block" parent="Theme.CalmOtter.Sage" />
    <style name="Theme.CalmOtter.Sage.WithActionBar" parent="Theme.CalmOtter.Base.WithActionBar">
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/sage_on_primary</item>
        <item name="colorPrimaryContainer">@color/sage_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sage_on_primary_container</item>
        <item name="colorSecondary">@color/sage_secondary</item>
        <item name="colorOnSecondary">@color/sage_on_secondary</item>
        <item name="colorSecondaryContainer">@color/sage_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sage_on_secondary_container</item>
        <item name="android:windowBackground">@color/sage_background</item>
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_surface</item>
        <item name="colorSurfaceVariant">@color/sage_surface_variant</item>
        <item name="colorOnSurfaceVariant">#404943</item>
        <!-- Il popup dell'ActionBar (es. il "⋮" di Cronologia) non eredita i
             colori di questo tema direttamente: Material3 lo mostra dentro un
             ThemeOverlay a parte (?attr/actionBarPopupTheme, di default
             ThemeOverlay.Material3.Light nella libreria) con il proprio
             colorSurface fisso — da cui il popup restava sempre lavanda a
             prescindere dalla palette, segnalato direttamente ("colore
             errato e non del tema"). Verificato empiricamente (misura pixel)
             che sovrascrivere solo popupMenuBackground/colorSurface qui non
             bastava proprio per questo: serve il proprio ThemeOverlay. -->
        <item name="actionBarPopupTheme">@style/ThemeOverlay.CalmOtter.Sage.PopupMenu</item>
    </style>

    <!-- LAVENDER THEME -->
    <style name="Theme.CalmOtter.Lavender" parent="Theme.CalmOtter.Base">
        <item name="colorPrimary">@color/lavender_primary</item>
        <item name="colorOnPrimary">@color/lavender_on_primary</item>
        <item name="colorPrimaryContainer">@color/lavender_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lavender_on_primary_container</item>
        <item name="colorSecondary">@color/lavender_secondary</item>
        <item name="colorOnSecondary">@color/lavender_on_secondary</item>
        <item name="colorSecondaryContainer">@color/lavender_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lavender_on_secondary_container</item>
        <item name="android:windowBackground">@color/lavender_background</item>
        <item name="colorSurface">@color/lavender_surface</item>
        <item name="colorOnSurface">@color/lavender_on_surface</item>
        <item name="colorSurfaceVariant">@color/lavender_surface_variant</item>
        <item name="colorOnSurfaceVariant">#49454f</item>
    </style>
    <style name="Theme.CalmOtter.Lavender.Block" parent="Theme.CalmOtter.Lavender" />
    <style name="Theme.CalmOtter.Lavender.WithActionBar" parent="Theme.CalmOtter.Base.WithActionBar">
        <item name="colorPrimary">@color/lavender_primary</item>
        <item name="colorOnPrimary">@color/lavender_on_primary</item>
        <item name="colorPrimaryContainer">@color/lavender_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lavender_on_primary_container</item>
        <item name="colorSecondary">@color/lavender_secondary</item>
        <item name="colorOnSecondary">@color/lavender_on_secondary</item>
        <item name="colorSecondaryContainer">@color/lavender_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lavender_on_secondary_container</item>
        <item name="android:windowBackground">@color/lavender_background</item>
        <item name="colorSurface">@color/lavender_surface</item>
        <item name="colorOnSurface">@color/lavender_on_surface</item>
        <item name="colorSurfaceVariant">@color/lavender_surface_variant</item>
        <item name="colorOnSurfaceVariant">#49454f</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.CalmOtter.Lavender.PopupMenu</item>
    </style>

    <!-- TERRACOTTA THEME -->
    <style name="Theme.CalmOtter.Terracotta" parent="Theme.CalmOtter.Base">
        <item name="colorPrimary">@color/terracotta_primary</item>
        <item name="colorOnPrimary">@color/terracotta_on_primary</item>
        <item name="colorPrimaryContainer">@color/terracotta_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/terracotta_on_primary_container</item>
        <item name="colorSecondary">@color/terracotta_secondary</item>
        <item name="colorOnSecondary">@color/terracotta_on_secondary</item>
        <item name="colorSecondaryContainer">@color/terracotta_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/terracotta_on_secondary_container</item>
        <item name="android:windowBackground">@color/terracotta_background</item>
        <item name="colorSurface">@color/terracotta_surface</item>
        <item name="colorOnSurface">@color/terracotta_on_surface</item>
        <item name="colorSurfaceVariant">@color/terracotta_surface_variant</item>
        <item name="colorOnSurfaceVariant">#53433f</item>
    </style>
    <style name="Theme.CalmOtter.Terracotta.Block" parent="Theme.CalmOtter.Terracotta" />
    <style name="Theme.CalmOtter.Terracotta.WithActionBar" parent="Theme.CalmOtter.Base.WithActionBar">
        <item name="colorPrimary">@color/terracotta_primary</item>
        <item name="colorOnPrimary">@color/terracotta_on_primary</item>
        <item name="colorPrimaryContainer">@color/terracotta_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/terracotta_on_primary_container</item>
        <item name="colorSecondary">@color/terracotta_secondary</item>
        <item name="colorOnSecondary">@color/terracotta_on_secondary</item>
        <item name="colorSecondaryContainer">@color/terracotta_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/terracotta_on_secondary_container</item>
        <item name="android:windowBackground">@color/terracotta_background</item>
        <item name="colorSurface">@color/terracotta_surface</item>
        <item name="colorOnSurface">@color/terracotta_on_surface</item>
        <item name="colorSurfaceVariant">@color/terracotta_surface_variant</item>
        <item name="colorOnSurfaceVariant">#53433f</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.CalmOtter.Terracotta.PopupMenu</item>
    </style>

    <!-- Overlay del popup dell'ActionBar per palette (vedi actionBarPopupTheme
         sopra) — popupMenuBackground esplicito, non solo colorSurface: il
         drawable di default (Widget.Material3.PopupMenu.Overflow) usa un
         macro M3 (@macro/m3_comp_menu_container_color) che non è detto legga
         colorSurface, quindi si sovrascrive direttamente l'attributo che il
         widget style consulta davvero, eliminando l'ambiguità. -->
    <style name="ThemeOverlay.CalmOtter.Sage.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/sage_surface</item>
        <item name="colorOnSurface">@color/sage_on_surface</item>
        <item name="popupMenuBackground">@color/sage_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.Lavender.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/lavender_surface</item>
        <item name="colorOnSurface">@color/lavender_on_surface</item>
        <item name="popupMenuBackground">@color/lavender_surface</item>
    </style>
    <style name="ThemeOverlay.CalmOtter.Terracotta.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorSurface">@color/terracotta_surface</item>
        <item name="colorOnSurface">@color/terracotta_on_surface</item>
        <item name="popupMenuBackground">@color/terracotta_surface</item>
    </style>

    <!-- Shared Styles -->
    <style name="Widget.CalmOtter.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.CalmOtter.Pill</item>
    </style>

    <style name="ShapeAppearance.CalmOtter.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.CalmOtter.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Default Aliases -->
    <style name="Theme.CalmOtter"          parent="Theme.CalmOtter.Sage" />
    <style name="Theme.CalmOtter.Block"    parent="Theme.CalmOtter.Sage.Block" />
    <style name="Theme.CalmOtter.WithActionBar" parent="Theme.CalmOtter.Sage.WithActionBar" />

</resources>
