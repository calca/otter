        <item name="colorOnPrimaryContainer">@color/lavender_on_primary_container</item>
        <item name="colorSecondary">@color/lavender_secondary</item>
        <item name="colorOnSecondary">@color/lavender_on_secondary</item>
        <item name="colorSecondaryContainer">@color/lavender_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lavender_on_secondary_container</item>
        <item name="android:windowBackground">@color/lavender_background</item>
        <item name="colorSurface">@color/lavender_surface</item>
        <item name="colorOnSurface">@color/lavender_on_surface</item>
        <item name="colorSurfaceVariant">@color/lavender_surface_variant</item>
        <item name="colorOnSurfaceVariant">#49454f</item>
