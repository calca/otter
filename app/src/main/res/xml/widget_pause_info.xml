<?xml version="1.0" encoding="utf-8"?>
<!--
    Una scorciatoia per iniziare una pausa: 1×1 (40dp) o 2×1 (110×40dp),
    vedi PauseWidgetProvider.kt. Le misure seguono la convenzione Android
    "70dp × celle − 30dp". Le taglie 2×2 e 4×2 con anello e frase sono state
    tolte: mostravano lo stato della pausa, che con il launcher coperto non
    si vede quasi mai.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="40dp"
    android:minHeight="40dp"
    tools:targetApi="31"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="110dp"
    android:maxResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_pause"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/widget_pause" />
